# Local hosting for this laptop (Ryzen 5 3500C, 8 GB RAM, Vega iGPU).
# Replies come from llama.cpp on the CPU. Cloud keys are ignored while
# OWAUA_LOCAL_ONLY=1.

DISCORD_TOKEN=

OWAUA_LOCAL_ONLY=1
OWAUA_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
OWAUA_LOCAL_MODEL=owaua
OWAUA_LOCAL_TIMEOUT_SECONDS=180
OWAUA_LOCAL_MAX_OUTPUT_TOKENS=160
OWAUA_LOCAL_FULL_MAX_OUTPUT_TOKENS=512
OWAUA_LOCAL_TEMPERATURE=0.7
OWAUA_LOCAL_TOP_P=0.9
OWAUA_LOCAL_ENABLE_TOOLS=0

OWAUA_LOCAL_AI_HOST=127.0.0.1
OWAUA_LOCAL_AI_PORT=8080
# Empty uses models/Qwen3.5-2B-UD-Q6_K_XL.gguf
OWAUA_LOCAL_AI_GGUF=
OWAUA_LOCAL_AI_THREADS=4
OWAUA_LOCAL_AI_CTX=4096
# Physical cores 0,2,4,6 on this Ryzen. SMT siblings stay free for the OS.
OWAUA_LOCAL_AI_CPU_MASK=0x55

BOT_OWNER_IDS=1172433512364769342
BOT_BLOCKED_USER_IDS=
BOT_ALLOWED_GUILD_IDS=
BOT_ALLOW_DMS=0
# One reply at a time. A second concurrent generation does not fit in 8 GB.
BOT_MAX_INFLIGHT=1
MUSIC_AUDIT_LOG=data/music-audit.jsonl
API_REQUESTS_PER_USER=30

# Optional. Used only when OWAUA_LOCAL_ONLY=0.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
OPENAI_FULL_MODEL=gpt-5.6-luna
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_FULL_MODEL=deepseek-v4.1-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=google/gemini-3.1-flash-lite
OWAUA_GEMINI_ONLY=0
CLAUDE_FULL_MODEL=anthropic/claude-haiku-4-5
GEMINI_FULL_MODEL=google/gemini-3.5-flash-lite
GLM_FULL_MODEL=zai/glm-5.3-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_LOG_URL=
CLOUDFLARE_LOG_TOKEN=
